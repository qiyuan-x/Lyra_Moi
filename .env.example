# Development defaults. Runtime secrets are written under data/config/.env.
LYRA_DEPLOYMENT_MODE=desktop
LYRA_HOST=127.0.0.1
LYRA_PORT=3000
LYRA_DATA_DIR=./data
LYRA_WEB_DIST=./apps/web/dist
LYRA_NODE_EXECUTABLE=
LYRA_AGENT_SYSTEM_PROMPT_FILE=./resources/prompts/agent-system-v1.txt

# Optional paid provider checks. These are ignored unless explicitly enabled.
LYRA_RUN_LIVE_PROVIDER_TESTS=0
LYRA_LIVE_OPENAI_API_KEY=
LYRA_LIVE_OPENAI_BASE_URL=https://api.openai.com/v1
LYRA_LIVE_OPENAI_LLM_MODEL=
LYRA_LIVE_OPENAI_IMAGE_MODEL=
LYRA_LIVE_GEMINI_API_KEY=
LYRA_LIVE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LYRA_LIVE_GEMINI_LLM_MODEL=
LYRA_LIVE_GEMINI_IMAGE_MODEL=
LYRA_LIVE_COMPATIBLE_API_KEY=
LYRA_LIVE_COMPATIBLE_BASE_URL=
LYRA_LIVE_COMPATIBLE_LLM_MODEL=
LYRA_LIVE_COMPATIBLE_IMAGE_MODEL=
